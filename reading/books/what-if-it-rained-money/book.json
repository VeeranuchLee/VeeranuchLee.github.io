{
  "format": 1,
  "id": "what-if-it-rained-money",
  "title": "What If It Rained Money?",
  "style": "calm luminous paper-cut watercolour science storybook",
  "pages": [
    {"id": "cover", "kind": "cover", "art": "art/cover.webp", "text": "", "narration": {"clip": "audio/pages/what-if-it-rained-money/cover.m4a", "timing": "audio/pages/what-if-it-rained-money/cover.timing.json"}},
    {"id": "money-rain", "art": "art/money-rain.webp", "text": "One night, money fell from the sky. It fell on every roof and every garden.", "quickWords": [{"en": "money", "th": "เงิน"}, {"en": "roof", "th": "หลังคา"}, {"en": "garden", "th": "สวน"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/money-rain.m4a", "timing": "audio/pages/what-if-it-rained-money/money-rain.timing.json"}},
    {"id": "piles-of-money", "art": "art/piles-of-money.webp", "text": "In the morning, everyone had piles and piles of money. Everyone felt rich.", "quickWords": [{"en": "pile", "th": "กอง"}, {"en": "rich", "th": "รวย"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/piles-of-money.m4a", "timing": "audio/pages/what-if-it-rained-money/piles-of-money.timing.json"}},
    {"id": "same-toys", "art": "art/same-toys.webp", "text": "But the toy shop had the same toys as yesterday. Three bears. One drum. One red bike.", "quickWords": [{"en": "toy shop", "th": "ร้านขายของเล่น"}, {"en": "bear", "th": "หมี"}, {"en": "bike", "th": "จักรยาน"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/same-toys.m4a", "timing": "audio/pages/what-if-it-rained-money/same-toys.timing.json"}},
    {"id": "the-queue", "art": "art/the-queue.webp", "text": "Everyone ran to the shops at once. Everyone wanted the same toys.", "quickWords": [{"en": "shops", "th": "ร้านค้า"}, {"en": "at once", "th": "พร้อมกัน"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/the-queue.m4a", "timing": "audio/pages/what-if-it-rained-money/the-queue.timing.json"}},
    {"id": "no-bear-left", "art": "art/no-bear-left.webp", "text": "The last bear went home with one family. The next family had a big pile of money and no bear.", "quickWords": [{"en": "bear", "th": "หมี"}, {"en": "family", "th": "ครอบครัว"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/no-bear-left.m4a", "timing": "audio/pages/what-if-it-rained-money/no-bear-left.timing.json"}},
    {"id": "new-tag", "art": "art/new-tag.webp", "text": "The cookie shop put up a new tag. Yesterday, one cookie cost one coin. Today, one cookie cost a tall, tall pile.", "quickWords": [{"en": "tag", "th": "ป้ายราคา"}, {"en": "cookie", "th": "คุกกี้"}, {"en": "coin", "th": "เหรียญ"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/new-tag.m4a", "timing": "audio/pages/what-if-it-rained-money/new-tag.timing.json"}},
    {"id": "one-small-cookie", "art": "art/one-small-cookie.webp", "text": "A tall pile of money bought one small cookie. The rain did not make more cookies.", "quickWords": [{"en": "cookie", "th": "คุกกี้"}, {"en": "bought", "th": "ซื้อ"}, {"en": "rain", "th": "ฝน"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/one-small-cookie.m4a", "timing": "audio/pages/what-if-it-rained-money/one-small-cookie.timing.json"}},
    {"id": "the-new-word", "art": "art/the-new-word.webp", "text": "When there is more money than things, prices go up. Grown-ups call this inflation.", "quickWords": [{"en": "prices", "th": "ราคา"}, {"en": "inflation", "th": "เงินเฟ้อ"}, {"en": "grown-ups", "th": "ผู้ใหญ่"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/the-new-word.m4a", "timing": "audio/pages/what-if-it-rained-money/the-new-word.timing.json"}},
    {"id": "not-greedy", "art": "art/not-greedy.webp", "text": "The cookie shop was not being greedy. Only a few cookies were left, and the queue was long.", "quickWords": [{"en": "greedy", "th": "โลภ"}, {"en": "queue", "th": "คิว"}, {"en": "left", "th": "เหลืออยู่"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/not-greedy.m4a", "timing": "audio/pages/what-if-it-rained-money/not-greedy.timing.json"}},
    {"id": "thin-harvest", "art": "art/thin-harvest.webp", "text": "Prices can go up another way too. One dry year, less wheat grew. The bakery baked fewer loaves, and bread cost more.", "quickWords": [{"en": "wheat", "th": "ข้าวสาลี"}, {"en": "bread", "th": "ขนมปัง"}, {"en": "dry", "th": "แห้งแล้ง"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/thin-harvest.m4a", "timing": "audio/pages/what-if-it-rained-money/thin-harvest.timing.json"}},
    {"id": "making-more", "art": "art/making-more.webp", "text": "What helped? Making more things. The oven was lit, and more cookies were baked. More bears were sewn.", "quickWords": [{"en": "oven", "th": "เตาอบ"}, {"en": "baked", "th": "อบ"}, {"en": "sewn", "th": "เย็บ"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/making-more.m4a", "timing": "audio/pages/what-if-it-rained-money/making-more.timing.json"}},
    {"id": "share-and-trade", "art": "art/share-and-trade.webp", "text": "Sharing helped. Trading helped. And saving, coin by coin, helps you get the thing you love.", "quickWords": [{"en": "sharing", "th": "แบ่งปัน"}, {"en": "trading", "th": "แลกเปลี่ยน"}, {"en": "saving", "th": "การออม"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/share-and-trade.m4a", "timing": "audio/pages/what-if-it-rained-money/share-and-trade.timing.json"}},
    {"id": "closing", "kind": "closing", "art": "art/closing.webp", "text": "Real riches are not paper. Real riches are cookies, homes, helpers and play.", "quickWords": [{"en": "riches", "th": "ความมั่งคั่ง"}, {"en": "helpers", "th": "ผู้ช่วยเหลือ"}, {"en": "play", "th": "การเล่น"}], "narration": {"clip": "audio/pages/what-if-it-rained-money/closing.m4a", "timing": "audio/pages/what-if-it-rained-money/closing.timing.json"}}
  ]
}
