    {"id": "what-is-a-galaxy", "art": "art/what-is-a-galaxy.webp", "text": "A galaxy is a huge family of stars, gas and dust. Gravity holds it all together.", "quickWords": [{"en": "galaxy", "th": "ดาราจักร"}, {"en": "stars", "th": "ดาว"}, {"en": "gravity", "th": "แรงโน้มถ่วง"}], "narration": {"clip": "audio/pages/milky-way/what-is-a-galaxy.m4a", "timing": "audio/pages/milky-way/what-is-a-galaxy.timing.json"}},
    {"id": "many-galaxies", "art": "art/many-galaxies.webp", "text": "There are many, many galaxies. Astronomers think there are about two trillion of them.", "quickWords": [{"en": "galaxies", "th": "ดาราจักร"}, {"en": "astronomers", "th": "นักดาราศาสตร์"}, {"en": "trillion", "th": "ล้านล้าน"}], "narration": {"clip": "audio/pages/milky-way/many-galaxies.m4a", "timing": "audio/pages/milky-way/many-galaxies.timing.json"}},
    {"id": "our-galaxy", "art": "art/our-galaxy.webp", "text": "We live inside a galaxy. Our galaxy is called the Milky Way.", "quickWords": [{"en": "inside", "th": "ข้างใน"}, {"en": "galaxy", "th": "ดาราจักร"}, {"en": "Milky Way", "th": "ทางช้างเผือก"}], "narration": {"clip": "audio/pages/milky-way/our-galaxy.m4a", "timing": "audio/pages/milky-way/our-galaxy.timing.json"}},
    {"id": "band-of-light", "art": "art/band-of-light.webp", "text": "From a dark place, the Milky Way looks like a faint, milky river of light across the sky.", "quickWords": [{"en": "dark", "th": "มืด"}, {"en": "light", "th": "แสง"}, {"en": "sky", "th": "ท้องฟ้า"}], "narration": {"clip": "audio/pages/milky-way/band-of-light.m4a", "timing": "audio/pages/milky-way/band-of-light.timing.json"}},
    {"id": "so-many-stars", "art": "art/so-many-stars.webp", "text": "The Milky Way has more than one hundred billion stars. Our Sun is one of them.", "quickWords": [{"en": "billion", "th": "พันล้าน"}, {"en": "stars", "th": "ดาว"}, {"en": "Sun", "th": "ดวงอาทิตย์"}], "narration": {"clip": "audio/pages/milky-way/so-many-stars.m4a", "timing": "audio/pages/milky-way/so-many-stars.timing.json"}},
    {"id": "our-place", "art": "art/our-place.webp", "text": "Our Sun sits about halfway out from the middle of the galaxy, in a spiral arm.", "quickWords": [{"en": "Sun", "th": "ดวงอาทิตย์"}, {"en": "middle", "th": "ตรงกลาง"}, {"en": "spiral arm", "th": "แขนก้นหอย"}], "narration": {"clip": "audio/pages/milky-way/our-place.m4a", "timing": "audio/pages/milky-way/our-place.timing.json"}},
    {"id": "long-trip", "art": "art/long-trip.webp", "text": "The whole solar system travels around the middle of the galaxy. One trip takes about 240 million years.", "quickWords": [{"en": "solar system", "th": "ระบบสุริยะ"}, {"en": "trip", "th": "การเดินทาง"}, {"en": "million", "th": "ล้าน"}], "narration": {"clip": "audio/pages/milky-way/long-trip.m4a", "timing": "audio/pages/milky-way/long-trip.timing.json"}},
    {"id": "middle-secret", "art": "art/middle-secret.webp", "text": "In the very middle of our galaxy hides a giant black hole. It is far, far away from us.", "quickWords": [{"en": "middle", "th": "ตรงกลาง"}, {"en": "black hole", "th": "หลุมดำ"}, {"en": "far", "th": "ไกล"}], "narration": {"clip": "audio/pages/milky-way/middle-secret.m4a", "timing": "audio/pages/milky-way/middle-secret.timing.json"}},
    {"id": "galaxy-shapes", "art": "art/galaxy-shapes.webp", "text": "Galaxies have different shapes. Some are spirals like ours, some are round, and some are lumpy.", "quickWords": [{"en": "shapes", "th": "รูปร่าง"}, {"en": "spirals", "th": "ก้นหอย"}, {"en": "round", "th": "กลม"}], "narration": {"clip": "audio/pages/milky-way/galaxy-shapes.m4a", "timing": "audio/pages/milky-way/galaxy-shapes.timing.json"}},
    {"id": "closing", "kind": "closing", "art": "art/closing.webp", "text": "Our whole world rides around the galaxy with the Sun. Goodnight, Milky Way!", "quickWords": [{"en": "world", "th": "โลก"}, {"en": "rides", "th": "เคลื่อนไปด้วย"}, {"en": "Milky Way", "th": "ทางช้างเผือก"}], "narration": {"clip": "audio/pages/milky-way/closing.m4a", "timing": "audio/pages/milky-way/closing.timing.json"}}
