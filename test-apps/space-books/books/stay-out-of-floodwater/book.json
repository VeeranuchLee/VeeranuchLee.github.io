  "id": "stay-out-of-floodwater",
  "title": "Why We Stay Out of Floodwater",
  "style": "calm luminous paper-cut watercolour science storybook",
  "pages": [
    {"id": "cover", "kind": "cover", "art": "art/cover.webp", "text": "", "narration": {"clip": "audio/pages/stay-out-of-floodwater/cover.m4a", "timing": "audio/pages/stay-out-of-floodwater/cover.timing.json"}},
    {"id": "pool-or-floodwater", "art": "art/pool-or-floodwater.webp", "text": "A swimming pool and a flooded road both have water. Are they the same? No. Floodwater can have dangers we cannot see.", "quickWords": [{"en": "swimming pool", "th": "สระว่ายน้ำ"}, {"en": "flooded road", "th": "ถนนน้ำท่วม"}, {"en": "dangers", "th": "อันตราย"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/pool-or-floodwater.m4a", "timing": "audio/pages/stay-out-of-floodwater/pool-or-floodwater.timing.json"}},
    {"id": "stronger-than-it-looks", "art": "art/stronger-than-it-looks.webp", "text": "Moving water can be much stronger than it looks. Even people who can swim should stay out of floodwater.", "quickWords": [{"en": "moving water", "th": "น้ำที่กำลังไหล"}, {"en": "stronger", "th": "แรงกว่า"}, {"en": "swim", "th": "ว่ายน้ำ"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/stronger-than-it-looks.m4a", "timing": "audio/pages/stay-out-of-floodwater/stronger-than-it-looks.timing.json"}},
    {"id": "bottom-is-hidden", "art": "art/bottom-is-hidden.webp", "text": "Floodwater hides the bottom. You cannot always see where your next step will land.", "quickWords": [{"en": "bottom", "th": "พื้นด้านล่าง"}, {"en": "next step", "th": "ก้าวต่อไป"}, {"en": "land", "th": "วางลง"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/bottom-is-hidden.m4a", "timing": "audio/pages/stay-out-of-floodwater/bottom-is-hidden.timing.json"}},
    {"id": "hidden-objects", "art": "art/hidden-objects.webp", "text": "Floodwater can hide branches, metal, rubbish and broken things that can hurt us.", "quickWords": [{"en": "branches", "th": "กิ่งไม้"}, {"en": "metal", "th": "โลหะ"}, {"en": "broken", "th": "แตกหัก"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/hidden-objects.m4a", "timing": "audio/pages/stay-out-of-floodwater/hidden-objects.timing.json"}},
    {"id": "not-clean-play-water", "art": "art/not-clean-play-water.webp", "text": "Water from roads, drains, rubbish and muddy soil can mix together. Floodwater can carry dirty water and germs.", "quickWords": [{"en": "mix", "th": "ผสมกัน"}, {"en": "dirty water", "th": "น้ำสกปรก"}, {"en": "germs", "th": "เชื้อโรค"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/not-clean-play-water.m4a", "timing": "audio/pages/stay-out-of-floodwater/not-clean-play-water.timing.json"}},
    {"id": "water-and-electricity", "art": "art/water-and-electricity.webp", "text": "If water reaches damaged electrical things, stay away and tell a grown-up.", "quickWords": [{"en": "damaged", "th": "ชำรุด"}, {"en": "electrical things", "th": "อุปกรณ์ไฟฟ้า"}, {"en": "stay away", "th": "อยู่ให้ห่าง"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/water-and-electricity.m4a", "timing": "audio/pages/stay-out-of-floodwater/water-and-electricity.timing.json"}},
    {"id": "animals-need-dry-places", "art": "art/animals-need-dry-places.webp", "text": "Floods can make animals leave their usual homes. We do not touch them. We tell a grown-up.", "quickWords": [{"en": "animals", "th": "สัตว์"}, {"en": "usual homes", "th": "ที่อยู่เดิม"}, {"en": "touch", "th": "สัมผัส"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/animals-need-dry-places.m4a", "timing": "audio/pages/stay-out-of-floodwater/animals-need-dry-places.timing.json"}},
    {"id": "what-should-i-do", "kind": "closing", "art": "art/what-should-i-do.webp", "text": "Water where it should not be? Stay out. Something fell in? Tell a grown-up. Electrical thing near water? Stay away. Need to go somewhere? Stay with your grown-up. Floodwater does not have to look scary to be dangerous.", "quickWords": [{"en": "stay out", "th": "อย่าลงไป"}, {"en": "stay with", "th": "อยู่กับ"}, {"en": "dangerous", "th": "เป็นอันตราย"}], "narration": {"clip": "audio/pages/stay-out-of-floodwater/what-should-i-do.m4a", "timing": "audio/pages/stay-out-of-floodwater/what-should-i-do.timing.json"}}
  ]
}
