      "sourcePath": "solar-system-game/assets/audio/182-ferdinand-a-moon-of-uranus-the-furthest-moon-of-uran.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/ferdinand.m4a"
    },
    "sao": {
      "text": "Sao, a moon of Neptune. It takes eight years to go around Neptune once.",
      "sourcePath": "solar-system-game/assets/audio/207-sao-a-moon-of-neptune-it-takes-eight-years-to-go-aro.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/sao.m4a"
    },
    "laomedeia": {
      "text": "Laomedeia, a moon of Neptune. Named after a sea nymph, and found by telescope in 2002.",
      "sourcePath": "solar-system-game/assets/audio/184-laomedeia-a-moon-of-neptune-named-after-a-sea-nymph.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/laomedeia.m4a"
    },
    "psamathe": {
      "text": "Psamathe, a moon of Neptune. It goes around Neptune backwards, far out in the dark.",
      "sourcePath": "solar-system-game/assets/audio/185-psamathe-a-moon-of-neptune-it-goes-around-neptune-ba.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/psamathe.m4a"
    },
    "neso": {
      "text": "Neso, a moon of Neptune. It is further from its planet than any other moon we know.",
      "sourcePath": "solar-system-game/assets/audio/186-neso-a-moon-of-neptune-it-is-further-from-its-planet.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/neso.m4a"
    },
    "dysnomia": {
      "text": "Dysnomia, a moon of Eris. Eris has one moon, and this is it.",
      "sourcePath": "solar-system-game/assets/audio/187-dysnomia-a-moon-of-eris-eris-has-one-moon-and-this-i.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/dysnomia.m4a"
    },
    "hiiaka": {
      "text": "Hi'iaka, a moon of Haumea. The bigger of Haumea's two moons, made of clean ice.",
      "sourcePath": "solar-system-game/assets/audio/188-hi-iaka-a-moon-of-haumea-the-bigger-of-haumea-s-two.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/hiiaka.m4a"
    },
    "namaka": {
      "text": "Namaka, a moon of Haumea. The smaller of Haumea's two moons.",
      "sourcePath": "solar-system-game/assets/audio/189-namaka-a-moon-of-haumea-the-smaller-of-haumea-s-two.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/namaka.m4a"
    },
    "janus": {
      "text": "Janus, a moon of Saturn. It swaps orbits with Epimetheus every four years.",
      "sourcePath": "solar-system-game/assets/audio/216-janus-a-moon-of-saturn-it-swaps-orbits-with-epimethe.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/janus.m4a"
    },
    "epimetheus": {
      "text": "Epimetheus, a moon of Saturn. The other half of the swap. Same path, four years apart.",
      "sourcePath": "solar-system-game/assets/audio/217-epimetheus-a-moon-of-saturn-the-other-half-of-the-sw.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/epimetheus.m4a"
    },
    "prometheus": {
      "text": "Prometheus, a moon of Saturn. One of two sheepdog moons that keep a thin ring in line.",
      "sourcePath": "solar-system-game/assets/audio/218-prometheus-a-moon-of-saturn-one-of-two-sheepdog-moon.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/prometheus.m4a"
    },
    "pandora": {
      "text": "Pandora, a moon of Saturn. The other sheepdog, working the far side of the same ring.",
      "sourcePath": "solar-system-game/assets/audio/219-pandora-a-moon-of-saturn-the-other-sheepdog-working.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/pandora.m4a"
    },
    "pan": {
      "text": "Pan, a moon of Saturn. Shaped like a ravioli, with a ridge round its middle.",
      "sourcePath": "solar-system-game/assets/audio/220-pan-a-moon-of-saturn-shaped-like-a-ravioli-with-a-ri.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/pan.m4a"
    },
    "atlas": {
      "text": "Atlas, a moon of Saturn. Even flatter than Pan, like a little flying saucer.",
      "sourcePath": "solar-system-game/assets/audio/221-atlas-a-moon-of-saturn-even-flatter-than-pan-like-a.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/atlas.m4a"
    },
    "daphnis": {
      "text": "Daphnis, a moon of Saturn. It flies down a gap in the rings and makes waves.",
      "sourcePath": "solar-system-game/assets/audio/222-daphnis-a-moon-of-saturn-it-flies-down-a-gap-in-the.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/daphnis.m4a"
    },
    "himalia": {
      "text": "Himalia, a moon of Jupiter. The biggest of Jupiter's far-out, dark little moons.",
      "sourcePath": "solar-system-game/assets/audio/223-himalia-a-moon-of-jupiter-the-biggest-of-jupiter-s-f.m4a",
      "runtimePath": "solar-storybook/assets-runtime/narration/moon-facts/himalia.m4a"
    }
  }
}
