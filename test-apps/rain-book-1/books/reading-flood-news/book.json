    {"id": "cover", "kind": "cover", "art": "art/cover.webp", "text": "", "narration": {"clip": "audio/pages/reading-flood-news/cover.m4a", "timing": "audio/pages/reading-flood-news/cover.timing.json"}},
    {"id": "millimetres-decoded", "art": "art/millimetres-decoded.webp", "text": "Each millimetre of rain means one litre of water on a square metre.", "quickWords": [{"en": "millimetre", "th": "มิลลิเมตร"}, {"en": "litre", "th": "ลิตร"}, {"en": "square metre", "th": "ตารางเมตร"}], "narration": {"clip": "audio/pages/reading-flood-news/millimetres-decoded.m4a", "timing": "audio/pages/reading-flood-news/millimetres-decoded.timing.json"}},
    {"id": "accumulated-decoded", "art": "art/accumulated-decoded.webp", "text": "Accumulated rainfall is rain added up over a set time, like one whole day.", "quickWords": [{"en": "accumulated rainfall", "th": "ปริมาณฝนสะสม"}, {"en": "set time", "th": "ช่วงเวลาที่กำหนด"}, {"en": "whole day", "th": "ทั้งวัน"}], "narration": {"clip": "audio/pages/reading-flood-news/accumulated-decoded.m4a", "timing": "audio/pages/reading-flood-news/accumulated-decoded.timing.json"}},
    {"id": "radar-decoded", "art": "art/radar-decoded.webp", "text": "Radar maps show where rain was falling a short time ago. The key explains the colours.", "quickWords": [{"en": "radar", "th": "เรดาร์"}, {"en": "map", "th": "แผนที่"}, {"en": "colour", "th": "สี"}], "narration": {"clip": "audio/pages/reading-flood-news/radar-decoded.m4a", "timing": "audio/pages/reading-flood-news/radar-decoded.timing.json"}},
    {"id": "level-decoded", "art": "art/level-decoded.webp", "text": "The water level tells how high the river surface is on its gauge. Rising or falling matters most.", "quickWords": [{"en": "water level", "th": "ระดับน้ำ"}, {"en": "gauge", "th": "มาตรวัด"}, {"en": "rising", "th": "ระดับน้ำสูงขึ้น"}], "narration": {"clip": "audio/pages/reading-flood-news/level-decoded.m4a", "timing": "audio/pages/reading-flood-news/level-decoded.timing.json"}},
    {"id": "low-lying-decoded", "art": "art/low-lying-decoded.webp", "text": "A low-lying area is low, flat ground. Water collects there first.", "quickWords": [{"en": "low-lying area", "th": "พื้นที่ลุ่มต่ำ"}, {"en": "flat ground", "th": "พื้นราบ"}, {"en": "collect", "th": "สะสม"}], "narration": {"clip": "audio/pages/reading-flood-news/low-lying-decoded.m4a", "timing": "audio/pages/reading-flood-news/low-lying-decoded.timing.json"}},
    {"id": "closures-decoded", "art": "art/closures-decoded.webp", "text": "A closed road keeps cars away from deep water. This is a road closure. Barriers are helpers.", "quickWords": [{"en": "road closure", "th": "ปิดการจราจร"}, {"en": "barrier", "th": "เครื่องกั้น"}, {"en": "car", "th": "รถยนต์"}], "narration": {"clip": "audio/pages/reading-flood-news/closures-decoded.m4a", "timing": "audio/pages/reading-flood-news/closures-decoded.timing.json"}},
    {"id": "flash-flood-decoded", "art": "art/flash-flood-decoded.webp", "text": "A flash flood arrives quickly, in hills or in towns. Families move to the marked safe high ground and wait.", "quickWords": [{"en": "flash flood", "th": "น้ำท่วมฉับพลัน"}, {"en": "high ground", "th": "ที่ดอน"}, {"en": "family", "th": "ครอบครัว"}], "narration": {"clip": "audio/pages/reading-flood-news/flash-flood-decoded.m4a", "timing": "audio/pages/reading-flood-news/flash-flood-decoded.timing.json"}},
    {"id": "three-questions", "art": "art/three-questions.webp", "text": "Good listeners ask three questions. How much rain? Where is the water going? Is the level rising?", "quickWords": [{"en": "question", "th": "คำถาม"}, {"en": "listener", "th": "ผู้ฟัง"}, {"en": "water", "th": "น้ำ"}], "narration": {"clip": "audio/pages/reading-flood-news/three-questions.m4a", "timing": "audio/pages/reading-flood-news/three-questions.timing.json"}},
    {"id": "closing", "kind": "closing", "art": "art/closing.webp", "text": "Now the news makes sense. Next time we hear it, we can explain it.", "quickWords": [{"en": "news", "th": "ข่าว"}, {"en": "make sense", "th": "เข้าใจได้"}, {"en": "explain", "th": "อธิบาย"}], "narration": {"clip": "audio/pages/reading-flood-news/closing.m4a", "timing": "audio/pages/reading-flood-news/closing.timing.json"}}
