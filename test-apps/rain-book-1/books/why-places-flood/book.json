{
  "format": 1,
  "id": "why-places-flood",
  "title": "Why Does This Place Flood?",
  "style": "calm luminous paper-cut watercolour science storybook",
  "pages": [
    {"id": "cover", "kind": "cover", "art": "art/cover.webp", "text": "", "narration": {"clip": "audio/pages/why-places-flood/cover.m4a", "timing": "audio/pages/why-places-flood/cover.timing.json"}},
    {"id": "the-rule", "art": "art/the-rule.webp", "text": "A place floods when water comes in faster than it can flow away.", "quickWords": [{"en": "flood", "th": "น้ำท่วม"}, {"en": "flow away", "th": "ระบายออก"}, {"en": "faster", "th": "เร็วกว่า"}], "narration": {"clip": "audio/pages/why-places-flood/the-rule.m4a", "timing": "audio/pages/why-places-flood/the-rule.timing.json"}},
    {"id": "low-places", "art": "art/low-places.webp", "text": "A low-lying area is low ground. Water slides there and fills it first.", "quickWords": [{"en": "low-lying area", "th": "พื้นที่ลุ่มต่ำ"}, {"en": "ground", "th": "พื้นดิน"}, {"en": "slide", "th": "ไหลลง"}], "narration": {"clip": "audio/pages/why-places-flood/low-places.m4a", "timing": "audio/pages/why-places-flood/low-places.timing.json"}},
    {"id": "neighbors-differ", "art": "art/neighbors-differ.webp", "text": "Two houses on one street can have different elevations. The lower one sits in water first.", "quickWords": [{"en": "elevation", "th": "ระดับความสูงของพื้นที่"}, {"en": "house", "th": "บ้าน"}, {"en": "street", "th": "ถนน"}], "narration": {"clip": "audio/pages/why-places-flood/neighbors-differ.m4a", "timing": "audio/pages/why-places-flood/neighbors-differ.timing.json"}},
    {"id": "ground-full", "art": "art/ground-full.webp", "text": "Ground that is already wet takes in new rain slowly. Rain that comes faster stays on top.", "quickWords": [{"en": "wet", "th": "เปียก"}, {"en": "rain", "th": "ฝน"}, {"en": "take in", "th": "ซึมซับ"}], "narration": {"clip": "audio/pages/why-places-flood/ground-full.m4a", "timing": "audio/pages/why-places-flood/ground-full.timing.json"}},
    {"id": "drain-full", "art": "art/drain-full.webp", "text": "A drain can only carry so much water. This limit is its drainage capacity. Extra rain waits on the street.", "quickWords": [{"en": "drainage capacity", "th": "ความสามารถในการระบายน้ำ"}, {"en": "drain", "th": "ท่อระบายน้ำ"}, {"en": "extra rain", "th": "ฝนส่วนเกิน"}], "narration": {"clip": "audio/pages/why-places-flood/drain-full.m4a", "timing": "audio/pages/why-places-flood/drain-full.timing.json"}},
    {"id": "river-high", "art": "art/river-high.webp", "text": "When the water level in the river is higher than the canal, its gate closes. Pumps push the water out instead.", "quickWords": [{"en": "water level", "th": "ระดับน้ำ"}, {"en": "canal", "th": "คลอง"}, {"en": "pump", "th": "เครื่องสูบน้ำ"}], "narration": {"clip": "audio/pages/why-places-flood/river-high.m4a", "timing": "audio/pages/why-places-flood/river-high.timing.json"}},
    {"id": "water-waits", "art": "art/water-waits.webp", "text": "Flood water is patient. It recedes when the drains and rivers have room again.", "quickWords": [{"en": "recede", "th": "น้ำลด"}, {"en": "flood water", "th": "น้ำท่วม"}, {"en": "room", "th": "พื้นที่ว่าง"}], "narration": {"clip": "audio/pages/why-places-flood/water-waits.m4a", "timing": "audio/pages/why-places-flood/water-waits.timing.json"}},
    {"id": "watching-the-level", "art": "art/watching-the-level.webp", "text": "People read a staff gauge to watch the water level. Rising or falling is the big question.", "quickWords": [{"en": "staff gauge", "th": "แผ่นวัดระดับน้ำ"}, {"en": "rising", "th": "ระดับน้ำสูงขึ้น"}, {"en": "falling", "th": "น้ำลด"}], "narration": {"clip": "audio/pages/why-places-flood/watching-the-level.m4a", "timing": "audio/pages/why-places-flood/watching-the-level.timing.json"}},
    {"id": "closing", "kind": "closing", "art": "art/closing.webp", "text": "Next time a puddle grows, we can ask: where can this water go?", "quickWords": [{"en": "puddle", "th": "แอ่งน้ำ"}, {"en": "grow", "th": "ขยายใหญ่ขึ้น"}, {"en": "ask", "th": "ถาม"}], "narration": {"clip": "audio/pages/why-places-flood/closing.m4a", "timing": "audio/pages/why-places-flood/closing.timing.json"}}
  ]
}
