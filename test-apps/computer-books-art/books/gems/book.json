    {"id": "what-is-a-gem", "art": "art/what-is-a-gem.webp", "text": "A gem is a beautiful stone. People have loved gems for a very long time.", "narration": {"clip": "audio/pages/gems/what-is-a-gem.m4a", "timing": "audio/pages/gems/what-is-a-gem.timing.json"}},
    {"id": "minerals", "art": "art/minerals.webp", "text": "Most gems are minerals. Minerals are made by nature, and they are not alive.", "narration": {"clip": "audio/pages/gems/minerals.m4a", "timing": "audio/pages/gems/minerals.timing.json"}},
    {"id": "crystals", "art": "art/crystals.webp", "text": "Many gems are crystals. The tiny parts inside a crystal line up in a neat pattern.", "narration": {"clip": "audio/pages/gems/crystals.m4a", "timing": "audio/pages/gems/crystals.timing.json"}},
    {"id": "underground", "art": "art/underground.webp", "text": "Many gems grow slowly underground. Heat and pressure help them form.", "narration": {"clip": "audio/pages/gems/underground.m4a", "timing": "audio/pages/gems/underground.timing.json"}},
    {"id": "geode", "art": "art/geode.webp", "text": "A geode looks like a plain rock. Inside, it is lined with sparkling crystals.", "narration": {"clip": "audio/pages/gems/geode.m4a", "timing": "audio/pages/gems/geode.timing.json"}},
    {"id": "cutting", "art": "art/cutting.webp", "text": "A gem cutter shapes and polishes a rough stone. The flat faces, called facets, catch the light.", "narration": {"clip": "audio/pages/gems/cutting.m4a", "timing": "audio/pages/gems/cutting.timing.json"}},
    {"id": "diamond", "art": "art/diamond.webp", "text": "A diamond is made of carbon. It is the hardest natural material.", "narration": {"clip": "audio/pages/gems/diamond.m4a", "timing": "audio/pages/gems/diamond.timing.json"}},
    {"id": "ruby-sapphire", "art": "art/ruby-sapphire.webp", "text": "Rubies and sapphires are the same mineral. Tiny bits of other elements give them different colors.", "narration": {"clip": "audio/pages/gems/ruby-sapphire.m4a", "timing": "audio/pages/gems/ruby-sapphire.timing.json"}},
    {"id": "amethyst", "art": "art/amethyst.webp", "text": "Amethyst is purple quartz. Quartz comes in many colors.", "narration": {"clip": "audio/pages/gems/amethyst.m4a", "timing": "audio/pages/gems/amethyst.timing.json"}},
    {"id": "opal", "art": "art/opal.webp", "text": "Opal flashes with rainbow colors. Tiny shapes inside it bend the light.", "narration": {"clip": "audio/pages/gems/opal.m4a", "timing": "audio/pages/gems/opal.timing.json"}},
    {"id": "pearl-amber", "art": "art/pearl-amber.webp", "text": "Some gems come from living things. Pearls grow inside oysters, and amber is tree sap that turned hard.", "narration": {"clip": "audio/pages/gems/pearl-amber.m4a", "timing": "audio/pages/gems/pearl-amber.timing.json"}},
