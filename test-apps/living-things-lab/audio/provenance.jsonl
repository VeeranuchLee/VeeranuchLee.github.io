{"text": "The anther makes pollen. It sits at the top of a filament.", "topic": "flower", "part": "anther", "kind": "fact", "file": "audio/flower-anther-fact.m4a", "tool": "ElevenLabs text-to-speech API", "voice": "Alice – Clear, Engaging, Educational", "voice_id": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_multilingual_v2", "prompt": "The anther makes pollen. It sits at the top of a filament.", "rendered_at": "2026-11-05T05:18:55Z", "master_sha256": "0025110455280db904a00e175b0cf30643f6a5095bf9926d03f9563182df4090", "clip_sha256": "07069aa10cd83c94cf1307f1a4161213303b5807202f1f012a06057b4e9fc75f", "encoding": "afconvert AAC mono 64 kbps .m4a"}
