{"text": "The filament is a thin stalk. It holds the anther where pollen can be carried away.", "topic": "flower", "part": "filament", "kind": "fact", "file": "audio/flower-filament-fact.m4a", "tool": "ElevenLabs text-to-speech API", "voice": "Alice – Clear, Engaging, Educational", "voice_id": "Xb7hH8MSUJpSbSDYk0k2", "model": "eleven_multilingual_v2", "prompt": "The filament is a thin stalk. It holds the anther where pollen can be carried away.", "rendered_at": "2026-11-05T05:18:57Z", "master_sha256": "cd8913f06b16b7a8dbdf63e211557566e4eda08bb7c5ab212f9b2da99f766b64", "clip_sha256": "f02c909d04ef0d5739771ade17f82348da55f6abb75835dd578d3029ea512d23", "encoding": "afconvert AAC mono 64 kbps .m4a"}
