# What of starlight-storybook/ would go public, and what would not.
#
# NOT ENABLED. There is no entry for this app in release/registry.json, no service
# worker, no deployment repository and no hub card. This file records the intended
# shape so that when the owner decides to publish it, the decision is about
# publishing and not about working out what ships. `scripts/ship-list.py` reads it;
# `scripts/preflight.sh` runs it on every commit, which is why it exists now rather
# than later.
#
# Unlike Book 1, this book's twenty pages load two shared files, so `app/` ships.
# Book 1 keeps `app/` private because its pages never load it.
#
# `index.html` is the cover and is part of the book, so it ships from here rather
# than being written in the public repository the way Book 1's is.

[ship]
index.html
