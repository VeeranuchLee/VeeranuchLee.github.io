# Public files for the Writing Book test deployment. Paths are relative to
# writing-book/.
#
# Every tracked file must appear in exactly one section. The working notes —
# CONCEPT.md, the discussion trail, the README — are the owner's reasoning and
# never ship. The QC harnesses do not ship either: they exist to check the app,
# not to be part of it, and grading.html would hand a curious child a page of
# numbers.

[ship]
index.html
audio-wake.js
styles.css
# Zoom fix C: index.html loads it before any app script, so without this line a
# published copy would ask for a file the deploy never carried.
tap-zoom-guard.js
# The offline cache, added 2026-09-12. It is also the app's version: publish-app.sh reads
# CACHE_NAME out of this file and the release gate compares it against the live one, which
# is why an app without a worker cannot publish at all. Named, not wildcarded — a second
# worker appearing beside it must be a decision, not a default.
service-worker.js
letters.js
strokes.js
words.js
sound.js
vocab.js
# The My cards tray (2026-10-21): the child imports dictionary cards, they stay
# in one area on the first page, and all three activities start from it.
# my-cards.js is the tray's state, rules and picker; dictionary-cards.js is the
# GENERATED snapshot it reads -- built by tools/build-card-snapshot.py out of
# word-book/data/dictionary.json and held to it by tools/check-card-snapshot.py,
# both private under tools/* below. If the snapshot is ever missing here the
# tray still works; it just starts empty and the picker finds nothing.
my-cards.js
dictionary-cards.js
app.js
# The rendered voice, one directory per kind. NOT `audio/**`: that would also sweep
# manifest.json, which is private, and a file matching both sections is an error rather
# than a silent win for either. Naming the four kinds also means a fifth cannot default
# into shipping -- someone has to come back here, which is the point of this file.
audio/words/*
audio/spell/*
audio/letters/*
audio/cues/*
# One sentence per word, played by the say badge on each card.
audio/sentence/*
sentences.js
art/paper/*
# Interface art. Only the say badge so far, and it is named as a directory so a second
# piece of chrome cannot default into shipping without someone coming back here.
art/ui/*
art/words/picture/*
art/words/card/*

[private]
# The slicer's index of what it cut. words.js is generated from it, so the app
# never reads it at runtime — it belongs to the build, not to the site.
art/words/levels.json
# The render list for the 235 unrecorded lines. Same rule as levels.json, and it
# was on the wrong side of it until 2026-08-27: nothing reads this at runtime —
# `sound.js` only names it in a comment — so it is a build input, and it was
# sitting on a public site carrying an open question ("voice: TBD ... owner to
# confirm"). Moving it here DELETES it from the public repo, which is the one
# direction a publish is normally not allowed to go; that deletion was asked for.
audio/manifest.json
README.md
CONCEPT.md
work_progress_and_other_discussion.md
qc/*
# The build tools and, since 2026-09-20 (CG-162), the two mode gates:
# tools/check-modes.mjs plays Write it, Find letters and Spell it against a DOM
# harness, and tools/test-check-modes.py breaks a copy of the app eighteen ways to
# prove each of that gate's checks can go red. Both exist to check the app, not to
# be part of it, and tools/README.md is the reasoning behind them -- private, like
# every other working note here. The README is NAMED rather than swept up by the
# wildcard: the manifest gate refuses to let a Markdown file match `tools/*`, so that
# a document can never ship by accident.
tools/*
tools/README.md
# QA evidence (screenshots, logs, headless checks) -- about the work, not part of the app.
qa/**
qa/README.md
