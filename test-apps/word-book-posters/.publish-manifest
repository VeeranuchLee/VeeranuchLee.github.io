grammar-game.css
grammar-game.js
assets/grammar/**
data/grammar-questions.json
audio/grammar/rendered.json
audio/grammar/*.m4a
# Not in the service worker SHELL on purpose: 145 pictures today and 2,098 eventually is
# far too much to precache on install. They are runtime-cached on first view instead.
assets/words/**

# The spoken headwords: 2,020 clips in the pinned British voice (AUDIO-DIRECTION.md
# decision 11), 26 MB. NOT in the service worker SHELL, for the same reason the pictures
# are not -- precaching 26 MB on install to serve a tap that may never come is the wrong
# trade. Cached on first play by the worker's range-aware branch (an <audio> fetch is a
# 206 that cache.put() refuses, so the worker keeps the whole 200 and slices ranges from it).
audio/words/**

# The 26 reusable Alice letter-name clips (rendered and selected 2026-10-15; provenance in
# audio/letters.manifest.json). The worker range-caches them on first play; not precached.
audio/letters/*.m4a

# The spoken example sentences, audio/sentences/<sense>.m4a, plus rendered.json -- the
# record of the exact text each clip says, which the PAGE reads to decide whether a card
# may show its sentence speaker (so it ships; it is not a private render record). None
# rendered yet. Clips are NOT in the worker SHELL (cached on first play, like the words);
# the ledger is, so the page knows offline which cards have a current clip.
audio/sentences/**

[private]
# The bed's render record -- tool, model, prompt, credits measured, loop seam ratio. It is
# about the work, not part of the app: index.html plays audio/word-bed.m4a directly and
# never reads this file.
audio/word-bed.provenance.json
# The render record: which voice ID spoke the clips, what was rendered, what was
