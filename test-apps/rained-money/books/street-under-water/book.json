    {"id": "our-street", "art": "art/our-street.webp", "text": "This is our street. We know where to walk: along the pavement, beside the curb.", "quickWords": [{"en": "street", "th": "ถนน"}, {"en": "pavement", "th": "ทางเท้า"}, {"en": "curb", "th": "ขอบทางเท้า"}], "narration": {"clip": "audio/pages/street-under-water/our-street.m4a", "timing": "audio/pages/street-under-water/our-street.timing.json"}},
    {"id": "rain-keeps-falling", "art": "art/rain-keeps-falling.webp", "text": "Now water covers the street. It looks different.", "quickWords": [{"en": "water", "th": "น้ำ"}, {"en": "covers", "th": "ปกคลุม"}, {"en": "different", "th": "แตกต่าง"}], "narration": {"clip": "audio/pages/street-under-water/rain-keeps-falling.m4a", "timing": "audio/pages/street-under-water/rain-keeps-falling.timing.json"}},
    {"id": "where-did-everything-go", "art": "art/where-did-everything-go.webp", "text": "Can you still see the curb? Can you see the drain? Can you see the hole? They are still there. The water is hiding them.", "quickWords": [{"en": "drain", "th": "ท่อระบายน้ำ"}, {"en": "hole", "th": "หลุม"}, {"en": "hiding", "th": "ซ่อนอยู่"}], "narration": {"clip": "audio/pages/street-under-water/where-did-everything-go.m4a", "timing": "audio/pages/street-under-water/where-did-everything-go.timing.json"}},
    {"id": "look-under-water", "art": "art/look-under-water.webp", "text": "The water did not make the street smooth. It only hid the street.", "quickWords": [{"en": "smooth", "th": "เรียบ"}, {"en": "hid", "th": "ซ่อนไว้"}, {"en": "street", "th": "ถนน"}], "discoveries": [{"id": "drain", "clip": "audio/discoveries/street-under-water/look-under-water-drain.m4a", "label": "The water can hide a deep drain.", "x": 25, "y": 70, "w": 8, "h": 8}, {"id": "pothole", "clip": "audio/discoveries/street-under-water/look-under-water-pothole.m4a", "label": "The road may not be flat underneath.", "x": 46, "y": 64, "w": 8, "h": 8}, {"id": "debris", "clip": "audio/discoveries/street-under-water/look-under-water-debris.m4a", "label": "Objects can hide under the water.", "x": 63, "y": 68, "w": 8, "h": 8}, {"id": "runoff", "clip": "audio/discoveries/street-under-water/look-under-water-runoff.m4a", "label": "Floodwater can carry germs and dirty things.", "x": 78, "y": 53, "w": 8, "h": 8}, {"id": "electrical", "clip": "audio/discoveries/street-under-water/look-under-water-electrical.m4a", "label": "Stay away from electrical things near floodwater.", "x": 84, "y": 27, "w": 8, "h": 8}], "narration": {"clip": "audio/pages/street-under-water/look-under-water.m4a", "timing": "audio/pages/street-under-water/look-under-water.timing.json"}},
    {"id": "water-can-move", "art": "art/water-can-move.webp", "text": "Floodwater can push things. Water that looks calm can still be moving.", "quickWords": [{"en": "push", "th": "ผลัก"}, {"en": "calm", "th": "นิ่งสงบ"}, {"en": "moving", "th": "ไหลอยู่"}], "narration": {"clip": "audio/pages/street-under-water/water-can-move.m4a", "timing": "audio/pages/street-under-water/water-can-move.timing.json"}},
    {"id": "water-connects-places", "art": "art/water-connects-places.webp", "text": "Floodwater connects the road, drain, garden, rubbish area and canal. It can bring things from somewhere else.", "quickWords": [{"en": "connects", "th": "เชื่อมต่อ"}, {"en": "rubbish area", "th": "บริเวณทิ้งขยะ"}, {"en": "canal", "th": "คลอง"}], "narration": {"clip": "audio/pages/street-under-water/water-connects-places.m4a", "timing": "audio/pages/street-under-water/water-connects-places.timing.json"}},
    {"id": "hard-to-see", "art": "art/hard-to-see.webp", "text": "Some dangers are hidden. Some are too small to see.", "quickWords": [{"en": "dangers", "th": "อันตราย"}, {"en": "hidden", "th": "ซ่อนอยู่"}, {"en": "too small", "th": "เล็กเกินกว่าจะมองเห็น"}], "narration": {"clip": "audio/pages/street-under-water/hard-to-see.m4a", "timing": "audio/pages/street-under-water/hard-to-see.timing.json"}},
