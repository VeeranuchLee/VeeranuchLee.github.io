    {"id": "long-ago-rome", "art": "art/long-ago-rome.webp", "text": "Long ago, there was a city called Rome. The people of Rome were the Romans.", "quickWords": [{"en": "long ago", "th": "นานมาแล้ว"}, {"en": "Rome", "th": "โรม"}, {"en": "Romans", "th": "ชาวโรมัน"}], "narration": {"clip": "audio/pages/roman-gods/long-ago-rome.m4a", "timing": "audio/pages/roman-gods/long-ago-rome.timing.json"}},
    {"id": "story-gods", "art": "art/story-gods.webp", "text": "The Romans told stories about gods. Each god looked after something special.", "quickWords": [{"en": "stories", "th": "เรื่องเล่า"}, {"en": "gods", "th": "เทพเจ้า"}, {"en": "something special", "th": "สิ่งพิเศษ"}], "narration": {"clip": "audio/pages/roman-gods/story-gods.m4a", "timing": "audio/pages/roman-gods/story-gods.timing.json"}},
    {"id": "jupiter", "art": "art/jupiter.webp", "text": "This is Jupiter. He is the king of the gods. He looks after the sky and the thunder.", "quickWords": [{"en": "Jupiter", "th": "จูปิเตอร์"}, {"en": "king", "th": "กษัตริย์"}, {"en": "thunder", "th": "ฟ้าร้อง"}], "narration": {"clip": "audio/pages/roman-gods/jupiter.m4a", "timing": "audio/pages/roman-gods/jupiter.timing.json"}},
    {"id": "mercury", "art": "art/mercury.webp", "text": "This is Mercury. He is the messenger. He runs very fast on his winged sandals.", "quickWords": [{"en": "Mercury", "th": "เมอร์คิวรี"}, {"en": "messenger", "th": "ผู้ส่งสาร"}, {"en": "winged sandals", "th": "รองเท้าแตะมีปีก"}], "narration": {"clip": "audio/pages/roman-gods/mercury.m4a", "timing": "audio/pages/roman-gods/mercury.timing.json"}},
    {"id": "venus", "art": "art/venus.webp", "text": "This is Venus. She is the goddess of love and beauty.", "quickWords": [{"en": "Venus", "th": "วีนัส"}, {"en": "love", "th": "ความรัก"}, {"en": "beauty", "th": "ความงาม"}], "narration": {"clip": "audio/pages/roman-gods/venus.m4a", "timing": "audio/pages/roman-gods/venus.timing.json"}},
    {"id": "mars", "art": "art/mars.webp", "text": "This is Mars. He is a strong soldier god.", "quickWords": [{"en": "Mars", "th": "มาร์ส"}, {"en": "strong", "th": "แข็งแรง"}, {"en": "soldier", "th": "ทหาร"}], "narration": {"clip": "audio/pages/roman-gods/mars.m4a", "timing": "audio/pages/roman-gods/mars.timing.json"}},
    {"id": "neptune", "art": "art/neptune.webp", "text": "This is Neptune. He is the god of the sea.", "quickWords": [{"en": "Neptune", "th": "เนปจูน"}, {"en": "god", "th": "เทพเจ้า"}, {"en": "sea", "th": "ทะเล"}], "narration": {"clip": "audio/pages/roman-gods/neptune.m4a", "timing": "audio/pages/roman-gods/neptune.timing.json"}},
    {"id": "saturn", "art": "art/saturn.webp", "text": "This is Saturn. He is Jupiter's father. He is an old god who looked after farms.", "quickWords": [{"en": "Saturn", "th": "แซเทิร์น"}, {"en": "father", "th": "พ่อ"}, {"en": "farms", "th": "ไร่นา"}], "narration": {"clip": "audio/pages/roman-gods/saturn.m4a", "timing": "audio/pages/roman-gods/saturn.timing.json"}},
    {"id": "pluto", "art": "art/pluto.webp", "text": "This is Pluto. He looks after a deep, hidden world under the ground.", "quickWords": [{"en": "Pluto", "th": "พลูโต"}, {"en": "hidden world", "th": "โลกที่ซ่อนอยู่"}, {"en": "under the ground", "th": "ใต้พื้นดิน"}], "narration": {"clip": "audio/pages/roman-gods/pluto.m4a", "timing": "audio/pages/roman-gods/pluto.timing.json"}},
    {"id": "the-greeks", "art": "art/the-greeks.webp", "text": "The Greeks told stories about these gods too, with other names. Zeus is the Greek name for Jupiter.", "quickWords": [{"en": "Greeks", "th": "ชาวกรีก"}, {"en": "Zeus", "th": "ซูส"}, {"en": "other names", "th": "ชื่ออื่น"}], "narration": {"clip": "audio/pages/roman-gods/the-greeks.m4a", "timing": "audio/pages/roman-gods/the-greeks.timing.json"}},
