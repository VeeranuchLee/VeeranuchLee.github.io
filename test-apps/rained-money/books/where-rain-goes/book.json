{
  "format": 1,
  "id": "where-rain-goes",
  "title": "Where Does the Rain Go?",
  "style": "calm luminous paper-cut watercolour science storybook",
  "pages": [
    {"id": "cover", "kind": "cover", "art": "art/cover.webp", "text": "", "narration": {"clip": "audio/pages/where-rain-goes/cover.m4a", "timing": "audio/pages/where-rain-goes/cover.timing.json"}},
    {"id": "rain-lands", "art": "art/rain-lands.webp", "text": "Rain lands on soil, grass, roofs and roads. Each landing is the start of a different journey.", "quickWords": [{"en": "roof", "th": "หลังคา"}, {"en": "road", "th": "ถนน"}, {"en": "journey", "th": "เส้นทางน้ำ"}], "narration": {"clip": "audio/pages/where-rain-goes/rain-lands.m4a", "timing": "audio/pages/where-rain-goes/rain-lands.timing.json"}},
    {"id": "soil-sponge", "art": "art/soil-sponge.webp", "text": "Soil is like a sponge. It drinks the rain.", "quickWords": [{"en": "soil", "th": "ดิน"}, {"en": "sponge", "th": "ฟองน้ำ"}, {"en": "drink", "th": "ดูดซับ"}], "narration": {"clip": "audio/pages/where-rain-goes/soil-sponge.m4a", "timing": "audio/pages/where-rain-goes/soil-sponge.timing.json"}},
    {"id": "full-sponge", "art": "art/full-sponge.webp", "text": "A sponge can fill up. Soil that is full of water is called saturated soil. When rain comes faster than full soil can take it in, water stays on top.", "quickWords": [{"en": "saturated soil", "th": "ดินอิ่มน้ำ"}, {"en": "full", "th": "เต็ม"}, {"en": "on top", "th": "อยู่ด้านบน"}], "narration": {"clip": "audio/pages/where-rain-goes/full-sponge.m4a", "timing": "audio/pages/where-rain-goes/full-sponge.timing.json"}},
    {"id": "runoff", "art": "art/runoff.webp", "text": "Extra water flows across the ground. This flowing water is called runoff. It slides to lower places.", "quickWords": [{"en": "runoff", "th": "น้ำไหลบ่าบนผิวดิน"}, {"en": "ground", "th": "พื้นดิน"}, {"en": "lower place", "th": "พื้นที่ต่ำกว่า"}], "narration": {"clip": "audio/pages/where-rain-goes/runoff.m4a", "timing": "audio/pages/where-rain-goes/runoff.timing.json"}},
    {"id": "drains", "art": "art/drains.webp", "text": "In towns, water slips into drains under the street.", "quickWords": [{"en": "drain", "th": "ท่อระบายน้ำ"}, {"en": "town", "th": "เมือง"}, {"en": "street", "th": "ถนน"}], "narration": {"clip": "audio/pages/where-rain-goes/drains.m4a", "timing": "audio/pages/where-rain-goes/drains.timing.json"}},
    {"id": "canals-to-river", "art": "art/canals-to-river.webp", "text": "Drains lead to canals. Canals lead to rivers. Rivers carry water to the sea.", "quickWords": [{"en": "canal", "th": "คลอง"}, {"en": "river", "th": "แม่น้ำ"}, {"en": "sea", "th": "ทะเล"}], "narration": {"clip": "audio/pages/where-rain-goes/canals-to-river.m4a", "timing": "audio/pages/where-rain-goes/canals-to-river.timing.json"}},
    {"id": "sun-takes-water", "art": "art/sun-takes-water.webp", "text": "Some water waits in puddles and leaves. The sun lifts it back up as vapour. This is evaporation.", "quickWords": [{"en": "puddle", "th": "แอ่งน้ำ"}, {"en": "vapour", "th": "ไอน้ำ"}, {"en": "evaporation", "th": "การระเหย"}], "narration": {"clip": "audio/pages/where-rain-goes/sun-takes-water.m4a", "timing": "audio/pages/where-rain-goes/sun-takes-water.timing.json"}},
    {"id": "storage", "art": "art/storage.webp", "text": "People also catch rain. Tanks, ponds and reservoirs keep it for dry days.", "quickWords": [{"en": "tank", "th": "ถังเก็บน้ำ"}, {"en": "pond", "th": "บ่อน้ำ"}, {"en": "reservoir", "th": "อ่างเก็บน้ำ"}], "narration": {"clip": "audio/pages/where-rain-goes/storage.m4a", "timing": "audio/pages/where-rain-goes/storage.timing.json"}},
    {"id": "one-journey-map", "art": "art/one-journey-map.webp", "text": "Every drop of rain takes one of these journeys. Water that is stored can journey again another day.", "quickWords": [{"en": "journey", "th": "เส้นทางน้ำ"}, {"en": "stored", "th": "กักเก็บไว้"}, {"en": "drop", "th": "หยดน้ำ"}], "narration": {"clip": "audio/pages/where-rain-goes/one-journey-map.m4a", "timing": "audio/pages/where-rain-goes/one-journey-map.timing.json"}},
    {"id": "closing", "kind": "closing", "art": "art/closing.webp", "text": "Our paper boats follow the water downhill. Next time it rains, watch where the water goes!", "quickWords": [{"en": "paper boat", "th": "เรือกระดาษ"}, {"en": "downhill", "th": "ลงที่ต่ำ"}, {"en": "watch", "th": "สังเกต"}], "narration": {"clip": "audio/pages/where-rain-goes/closing.m4a", "timing": "audio/pages/where-rain-goes/closing.timing.json"}}
  ]
}
